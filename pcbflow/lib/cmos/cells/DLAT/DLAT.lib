/* DLAT — latch D transparente com E = 1 (latch SR de NANDs com entrada controlada; 4 NANDs) */
library(cmos_DLAT) {
  cell(DLAT) {
    area : 16;
    latch(IQ, IQN) {
      enable : "E";
      data_in : "D";
    }
    pin(D) { direction : input; }
    pin(E) { direction : input; }
    pin(Q) { direction : output; function : "IQ"; }
  }
}
