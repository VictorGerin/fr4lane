/* DLAT — latch D transparente com E = 1 (latch SR de NORs CTL; 4 NOR2 + inversor) */
library(ctl_DLAT) {
  cell(DLAT) {
    area : 24;
    latch(IQ, IQN) {
      enable : "E";
      data_in : "D";
    }
    pin(D) { direction : input; }
    pin(E) { direction : input; }
    pin(Q) { direction : output; function : "IQ"; }
  }
}
