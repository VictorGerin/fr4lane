/* DFFR — flip-flop D, borda de subida, clear assíncrono ativo baixo (CTL) */
library(ctl_DFFR) {
  cell(DFFR) {
    area : 65;
    ff(IQ, IQN) {
      clocked_on : "C";
      next_state : "D";
      clear : "!R";
    }
    pin(D) { direction : input; }
    pin(C) { direction : input; clock : true; }
    pin(R) { direction : input; }
    pin(Q) { direction : output; function : "IQ"; }
  }
}
