/* NOR3 — porta NOR de 3 entradas a válvulas termiônicas (3 válvulas em paralelo + 4 resistores) */
library(tube_NOR3) {
  cell(NOR3) {
    area : 7;
    pin(A) { direction : input; }
    pin(B) { direction : input; }
    pin(C) { direction : input; }
    pin(Y) { direction : output; function : "!(A | B | C)"; }
  }
}
