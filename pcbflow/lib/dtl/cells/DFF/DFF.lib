/* DFF — flip-flop D, borda de subida (6 NANDs DTL; 6 NPNs) */
library(dtl_DFF) {
  cell(DFF) {
    area : 37;
    ff(IQ, IQN) {
      clocked_on : "C";
      next_state : "D";
    }
    pin(D) { direction : input; }
    pin(C) { direction : input; clock : true; }
    pin(Q) { direction : output; function : "IQ"; }
  }
}
