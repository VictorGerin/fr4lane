{
  "name": "discrete_ctl",
  "family": "ctl",
  "description": "Lógica CTL (Core-Transistor Logic) com núcleos toroidais de ferrite, NPN BC548 em TO-92 e resistores de 1/4 W. As operações lógicas (OR, AND por coincidência de corrente e inibição) são calculadas pelo fluxo magnético nos enrolamentos do toroide e regeneradas por um único transistor por porta.",
  "supply": {
    "vdd": "VDD",
    "gnd": "GND",
    "voltage": "5V"
  },
  "footprints": "footprints.json",
  "liberty_header": [
    "delay_model : table_lookup;",
    "time_unit : \"1ns\";",
    "voltage_unit : \"1V\";",
    "current_unit : \"1mA\";",
    "capacitive_load_unit (1, pf);",
    "pulling_resistance_unit : \"1kohm\";"
  ],
  "decoupling": {
    "row": "CDEC",
    "bulk": "CBULK"
  },
  "placement": {
    "part_gap": 1.0,
    "row_gap": 6.0
  },
  "spice": {
    "_comment": "Simulação analógica das células CTL (fr4lane-cellsim): núcleo toroidal de ferrite de laço retangular (spice/FERRITE.lib) e transistor NPN BC548B (spice/BC548B.lib). Nos cantos, kcore escala a resistência dos enrolamentos e kic a corrente coerciva do ferrite (que cai com a temperatura e sobe a frio).",
    "models": {
      "CORE": "spice/FERRITE.lib",
      "NPN": "spice/BC548B.lib"
    },
    "corners": {
