{
  "name": "discrete_cmos",
  "family": "cmos",
  "description": "CMOS estático com MOSFETs discretos 2N7002/BSS84 (SOT-23).",
  "supply": {
    "vdd": "VDD",
    "gnd": "GND",
    "voltage": "5V"
  },
  "footprints": "../footprints.json",
  "liberty_header": [
    "delay_model : table_lookup;",
    "time_unit : \"1ns\";",
    "voltage_unit : \"1V\";",
    "current_unit : \"1mA\";",
    "capacitive_load_unit (1, pf);",
    "pulling_resistance_unit : \"1kohm\";"
  ],
  "decoupling": {
    "row": "CDEC",
    "bulk": "CBULK"
  },
  "placement": {
    "part_gap": 1,
    "part_gap_2layer": 1.0,
    "row_gap": 7
  },
  "spice": {
    "_comment": "Simulação analógica das células (fr4lane-cellsim). Modelos de nível 1 da Diodes (L = W = 100 µm). Cantos: o limiar dos MOSFETs na faixa da ficha (2N7002 de 1,0 a 2,5 V; BSS84 de -0,8 a -2,0 V), o VDD e a temperatura. Níveis em fração do VDD.",
    "models": {
      "NMOS": {
        "file": "spice/2N7002.lib",
        "instance": "L=100u W=100u"
      },
      "PMOS": {
        "file": "spice/BSS84.lib",
        "instance": "L=100u W=100u"
      }
    },
    "corners": {
      "típico": {
        "vdd": 5.0,
        "temp": 27
      },
      "lento": {
        "vdd": 4.75,
        "temp": 70,
        "params": {
          "NMOS": {
            "VTO": 2.5
          },
          "PMOS": {
            "VTO": -2.0
          }
        }
      },
      "rápido": {
        "vdd": 5.25,
        "temp": 0,
        "params": {
          "NMOS": {
            "VTO": 1.0
          },
          "PMOS": {
            "VTO": -0.8
          }
        }
      }
    },
    "levels": {
      "vih": 0.9,
      "vil": 0.1,
      "voh_min": 0.7,
      "vol_max": 0.3,
      "vth": 0.5
    },
    "timing": {
      "step": 2e-06,
      "period": 2e-06,
      "periods": [
        1e-06,
        5e-07,
        2e-07,
        1e-07,
        5e-08,
        2e-08,
        1e-08
      ],
      "holds": [
        1e-07,
        5e-08,
        2e-08,
        1e-08,
        5e-09,
        2e-09,
        1e-09,
        5e-10
      ],
      "setups": [
        1e-07,
        5e-08,
        2e-08,
        1e-08,
        5e-09,
        2e-09,
        1e-09,
        5e-10
      ],
      "resolution": 1e-10
    }
  }
}
