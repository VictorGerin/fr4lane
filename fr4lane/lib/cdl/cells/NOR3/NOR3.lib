/* NOR3 — porta NOR CDL de 3 entradas em 1 núcleo (1 núcleo de ferrite + 3 diodos + 3 resistores) */
library(cdl_NOR3) {
  cell(NOR3) {
    area : 7;
    pin(A) { direction : input; }
    pin(B) { direction : input; }
    pin(C) { direction : input; }
    pin(Y) { direction : output; function : "!(A | B | C)"; }
  }
}
