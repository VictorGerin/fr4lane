/* DLAT — latch D transparente com E = 1 (4 NOR2 + INV a válvulas termiônicas; 9 válvulas) */
library(tube_DLAT) {
  cell(DLAT) {
    area : 23;
    latch(IQ, IQN) {
      enable : "E";
      data_in : "D";
    }
    pin(D) { direction : input; }
    pin(E) { direction : input; }
    pin(Q) { direction : output; function : "IQ"; }
  }
}
