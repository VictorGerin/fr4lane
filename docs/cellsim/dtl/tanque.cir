* tanque — circuito sintetizado pelo pcbflow (18 células: BUF, DFFR, INV, NAND2, NAND3, NOR2, XOR2; 292 componentes)
* família discrete_dtl, canto típico (VDD 5 V, 27 °C)
* gerado por pcbflow-cellsim --design tanque --export; rodar: ngspice -b tanque.cir
*
* entradas no nível de pior caso: alto = 2.75 V, baixo = 0.4 V; cada saída leva uma carga de referência
* saída: 1 se >= 2.5 V, 0 se <= 0.4 V
*
* vetores de teste (medida: valor esperado):
*   vetor 0 (0-20 µs): clk=0 rst_n=0 nivel_baixo=0 nivel_alto=0  ->  s_estado_0__0: estado[0]=0, s_estado_1__0: estado[1]=0, s_bomba_0: bomba=0
*   vetor 1 (20-40 µs): clk=0 rst_n=1 nivel_baixo=0 nivel_alto=0  ->  s_estado_0__1: estado[0]=0, s_estado_1__1: estado[1]=0, s_bomba_1: bomba=0
*   vetor 2 (40-60 µs): clk=1 rst_n=1 nivel_baixo=0 nivel_alto=0  ->  s_estado_0__2: estado[0]=1, s_estado_1__2: estado[1]=0, s_bomba_2: bomba=1
*   vetor 3 (60-80 µs): clk=0 rst_n=1 nivel_baixo=1 nivel_alto=0  ->  s_estado_0__3: estado[0]=1, s_estado_1__3: estado[1]=0, s_bomba_3: bomba=1
*   vetor 4 (80-100 µs): clk=1 rst_n=1 nivel_baixo=1 nivel_alto=0  ->  s_estado_0__4: estado[0]=1, s_estado_1__4: estado[1]=0, s_bomba_4: bomba=1
*   vetor 5 (100-120 µs): clk=0 rst_n=1 nivel_baixo=0 nivel_alto=1  ->  s_estado_0__5: estado[0]=1, s_estado_1__5: estado[1]=0, s_bomba_5: bomba=1
*   vetor 6 (120-140 µs): clk=1 rst_n=1 nivel_baixo=0 nivel_alto=1  ->  s_estado_0__6: estado[0]=0, s_estado_1__6: estado[1]=1, s_bomba_6: bomba=0
*   vetor 7 (140-160 µs): clk=0 rst_n=1 nivel_baixo=1 nivel_alto=1  ->  s_estado_0__7: estado[0]=0, s_estado_1__7: estado[1]=1, s_bomba_7: bomba=0
*   vetor 8 (160-180 µs): clk=1 rst_n=1 nivel_baixo=1 nivel_alto=1  ->  s_estado_0__8: estado[0]=0, s_estado_1__8: estado[1]=1, s_bomba_8: bomba=0
*   vetor 9 (180-200 µs): clk=0 rst_n=1 nivel_baixo=0 nivel_alto=0  ->  s_estado_0__9: estado[0]=0, s_estado_1__9: estado[1]=1, s_bomba_9: bomba=0
*   vetor 10 (200-220 µs): clk=1 rst_n=1 nivel_baixo=0 nivel_alto=0  ->  s_estado_0__10: estado[0]=1, s_estado_1__10: estado[1]=1, s_bomba_10: bomba=0
*   vetor 11 (220-240 µs): clk=0 rst_n=1 nivel_baixo=1 nivel_alto=0  ->  s_estado_0__11: estado[0]=1, s_estado_1__11: estado[1]=1, s_bomba_11: bomba=0
*   vetor 12 (240-260 µs): clk=1 rst_n=1 nivel_baixo=1 nivel_alto=0  ->  s_estado_0__12: estado[0]=1, s_estado_1__12: estado[1]=1, s_bomba_12: bomba=0
*   vetor 13 (260-280 µs): clk=0 rst_n=1 nivel_baixo=0 nivel_alto=1  ->  s_estado_0__13: estado[0]=1, s_estado_1__13: estado[1]=1, s_bomba_13: bomba=0
*   vetor 14 (280-300 µs): clk=1 rst_n=1 nivel_baixo=0 nivel_alto=1  ->  s_estado_0__14: estado[0]=0, s_estado_1__14: estado[1]=0, s_bomba_14: bomba=0
*   vetor 15 (300-320 µs): clk=0 rst_n=1 nivel_baixo=1 nivel_alto=1  ->  s_estado_0__15: estado[0]=0, s_estado_1__15: estado[1]=0, s_bomba_15: bomba=0
*   vetor 16 (320-340 µs): clk=1 rst_n=1 nivel_baixo=1 nivel_alto=1  ->  s_estado_0__16: estado[0]=0, s_estado_1__16: estado[1]=0, s_bomba_16: bomba=0
*
* pcbflow-cellsim: canto típico
.temp 27
.param kup=1 kb=1
.model NPN NPN(Is=7.049f Xti=3 Eg=1.11 Vaf=54.76 Bf=250 Ise=78.17f Ne=1.479 Ikf=24.96m Nkf=.5381 Xtb=1.5 Br=1.2 Isc=27.51f Nc=1.775 Ikr=3.321 Rc=.9706 Cjc=4.25p Mjc=.3147 Vjc=.5697 Fc=.5 Cje=11.5p Mje=.6715 Vje=.5 Tr=10n Tf=410.7p Itf=1.12 Xtf=26.19 Vtf=10)
.model DIODE D(IS=4.352E-9 N=1.906 BV=110 IBV=0.0001 RS=0.6458 CJO=7.048E-13 VJ=0.869 M=0.03 FC=0.5 TT=3.48E-9)
.subckt INV A Y VDD GND
R1 VDD d1 {4700*kup}
D1 d1 A DIODE
DS1 d1 m1 DIODE
DS2 m1 b1 DIODE
RB b1 GND {10000*kb}
RL VDD Y {1500*kup}
Q1 Y b1 GND NPN
.ends INV
.subckt BUF A Y VDD GND
X1 A n VDD GND INV
X2 n Y VDD GND INV
.ends BUF
.subckt NAND2 A B Y VDD GND
R1 VDD d1 {4700*kup}
D1 d1 A DIODE
D2 d1 B DIODE
DS1 d1 m1 DIODE
DS2 m1 b1 DIODE
RB b1 GND {10000*kb}
RL VDD Y {1500*kup}
Q1 Y b1 GND NPN
.ends NAND2
.subckt NAND3 A B C Y VDD GND
R1 VDD d1 {4700*kup}
D1 d1 A DIODE
D2 d1 B DIODE
D3 d1 C DIODE
DS1 d1 m1 DIODE
DS2 m1 b1 DIODE
RB b1 GND {10000*kb}
RL VDD Y {1500*kup}
Q1 Y b1 GND NPN
.ends NAND3
.subckt DFFR D C R Q VDD GND
X1 n4 n2 n1 VDD GND NAND2
X2 n1 R C n2 VDD GND NAND3
X3 n2 C n4 n3 VDD GND NAND3
X4 n3 R D n4 VDD GND NAND3
X5 n2 QN Q VDD GND NAND2
X6 Q R n3 QN VDD GND NAND3
.ends DFFR
.subckt NOR2 A B Y VDD GND
R1 A d1 {6800*kb}
D1 d1 b1 DIODE
R2 B d2 {6800*kb}
D2 d2 b1 DIODE
RB b1 GND {22000*kb}
RL VDD Y {1500*kup}
Q1 Y b1 GND NPN
.ends NOR2
.subckt XOR2 A B Y VDD GND
X1 A B n1 VDD GND NAND2
X2 A n1 n2 VDD GND NAND2
X3 B n1 n3 VDD GND NAND2
X4 n2 n3 Y VDD GND NAND2
.ends XOR2
VDD vdd 0 5
V_clk n2 0 PWL(0 0.4 4e-05 0.4 4.0002e-05 2.75 6e-05 2.75 6.0002e-05 0.4 8e-05 0.4 8.0002e-05 2.75 0.0001 2.75 0.000100002 0.4 0.00012 0.4 0.000120002 2.75 0.00014 2.75 0.000140002 0.4 0.00016 0.4 0.000160002 2.75 0.00018 2.75 0.000180002 0.4 0.0002 0.4 0.000200002 2.75 0.00022 2.75 0.000220002 0.4 0.00024 0.4 0.000240002 2.75 0.00026 2.75 0.000260002 0.4 0.00028 0.4 0.000280002 2.75 0.0003 2.75 0.000300002 0.4 0.00032 0.4 0.000320002 2.75)
V_rst_n n3 0 PWL(0 0.4 2e-05 0.4 2.0002e-05 2.75)
V_nivel_baixo n4 0 PWL(0 0.4 6e-05 0.4 6.0002e-05 2.75 0.0001 2.75 0.000100002 0.4 0.00014 0.4 0.000140002 2.75 0.00018 2.75 0.000180002 0.4 0.00022 0.4 0.000220002 2.75 0.00026 2.75 0.000260002 0.4 0.0003 0.4 0.000300002 2.75)
V_nivel_alto n5 0 PWL(0 0.4 0.0001 0.4 0.000100002 2.75 0.00018 2.75 0.000180002 0.4 0.00026 0.4 0.000260002 2.75)
XU1 n4 n6 vdd 0 INV
XU2 n7 n8 vdd 0 INV
XU3 n9 n10 vdd 0 INV
XU4 n5 n11 vdd 0 INV
XU5 n8 n9 n12 vdd 0 NOR2
XU6 n7 n10 n11 n13 vdd 0 NAND3
XU7 n8 n9 n5 n14 vdd 0 NAND3
XU8 n7 n9 n15 vdd 0 XOR2
XU9 n13 n14 n15 n16 vdd 0 NAND3
XU10 n6 n13 n14 n17 vdd 0 NAND3
XU11 n16 n17 n18 vdd 0 NAND2
XU12 n7 n18 n19 vdd 0 XOR2
XU13 n20 n16 n17 n21 vdd 0 NAND3
XU14 n16 n21 n22 vdd 0 NAND2
XFF1 n19 n2 n3 n7 vdd 0 DFFR
XFF2 n22 n2 n3 n23 vdd 0 DFFR
XB1 n23 n9 vdd 0 BUF
XB2 n23 n20 vdd 0 BUF
Xld_estado_0_ n7 ldo_estado_0__Y vdd 0 INV
Xld_estado_1_ n23 ldo_estado_1__Y vdd 0 INV
Xld_bomba n12 ldo_bomba_Y vdd 0 INV
.tran 4e-08 0.00034
.control
run
linearize
set wr_singlescale
set wr_vecnames
wrdata tanque.dat v(n2) v(n3) v(n4) v(n5) v(n7) v(n23) v(n12)
meas tran s_estado_0__0 FIND v(n7) AT=1.9e-05
meas tran s_estado_1__0 FIND v(n23) AT=1.9e-05
