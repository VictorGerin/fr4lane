XFF1 n24 n2 n3 n6 vdd 0 DFFR
XFF2 n26 n2 n3 n8 vdd 0 DFFR
Xld_estado_0_ n6 ldo_estado_0__Y vdd 0 INV
Xld_estado_1_ n8 ldo_estado_1__Y vdd 0 INV
Xld_bomba n12 ldo_bomba_Y vdd 0 INV
.tran 4e-08 0.00034
.control
