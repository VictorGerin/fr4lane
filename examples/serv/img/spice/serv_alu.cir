XFF1 n59 n2 n44 vdd 0 DFF
XFF2 n33 n2 n21 vdd 0 DFF
Xld_o_cmp n56 ldo_o_cmp_Y vdd 0 INV
Xld_o_rd n48 ldo_o_rd_Y vdd 0 INV
.tran 4e-08 0.00032
.control
run
linearize
set wr_singlescale
