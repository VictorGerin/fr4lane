V_i_op_b n14 0 PWL(0 0.4)
V_i_buf n15 0 PWL(0 0.4)
XU1 n3 n16 vdd 0 INV
XU2 n6 n17 vdd 0 INV
XU3 n4 n18 vdd 0 INV
XU4 n8 n19 vdd 0 INV
XU5 n5 n16 n20 vdd 0 NAND2
